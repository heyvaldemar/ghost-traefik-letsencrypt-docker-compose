# Ghost + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…
# GHOST_MYSQL_IMAGE_TAG=mysql:8.4-oracle@sha256:…
# GHOST_IMAGE_TAG=ghost:6.61.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.ghost.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#
# Generate a new BCrypt hash (replace YOUR_STRONG_PASSWORD):
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# Or using docker without installing apache2-utils:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Ghost
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname and full URL for Ghost. The hostname must resolve to this
# server's public IP for the Let's Encrypt TLS-ALPN challenge. REQUIRED.
GHOST_HOSTNAME=ghost.example.com
GHOST_URL=https://ghost.example.com

# REQUIRED — generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
GHOST_DB_PASSWORD=change_me_before_first_start
GHOST_DB_ADMIN_PASSWORD=change_me_before_first_start

# Create the admin account at https://<GHOST_HOSTNAME>/ghost right after
# the first deploy — first visit wins.

# Defaults below are set in the compose file; override only to diverge.
# GHOST_DB_NAME=ghostdb
# GHOST_DB_USER=ghostdbbuser

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# MYSQL_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# MYSQL_BACKUPS_PATH=/srv/ghost-mysql/backups
# DATA_BACKUPS_PATH=/srv/ghost-application-data/backups
# DATA_PATH=/var/lib/ghost/content
# MYSQL_BACKUP_NAME=ghost-mysql-backup
# DATA_BACKUP_NAME=ghost-application-data-backup

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# GHOST_MYSQL_MEMORY_LIMIT=1g
# GHOST_MYSQL_CPU_LIMIT=1.0
# GHOST_MYSQL_MEMORY_RESERVATION=128m
# GHOST_MYSQL_CPU_RESERVATION=0.25
# GHOST_MEMORY_LIMIT=512m
# GHOST_CPU_LIMIT=1.0
# GHOST_MEMORY_RESERVATION=64m
# GHOST_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# GHOST_BACKUPS_MEMORY_LIMIT=256m
# GHOST_BACKUPS_CPU_LIMIT=0.5
# GHOST_BACKUPS_MEMORY_RESERVATION=32m
# GHOST_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits for a data-owning service to shut down before it
# sends SIGKILL. The default of ten seconds can cut short a PostgreSQL
# checkpoint, an InnoDB flush or a Redis save; sixty is the value this
# repository ships. Raise it if your dataset is large.
# GHOST_MYSQL_STOP_GRACE_PERIOD =60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# GHOST_MYSQL_IMAGE_VERSION=8.4-oracle
# GHOST_IMAGE_VERSION=6.61.0
